{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alshyra/sherlock-second-brain/schema/case.schema.json",
  "title": "Case",
  "description": "Transient investigation file. As long as a topic is not validated, it lives in a case. Once resolved, it is promoted into a fiche or skill via the MCP.",
  "type": "object",
  "required": [
    "id",
    "title",
    "status",
    "goal",
    "context",
    "hypotheses",
    "steps",
    "findings",
    "evidence",
    "tags",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^case-\\d{4}-\\d{2}-\\d{2}-\\d{3}$",
      "description": "Unique case id."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["open", "in_progress", "resolved", "abandoned"]
    },
    "goal": {
      "type": "string",
      "description": "Investigation goal (debug, plan, research)."
    },
    "context": {
      "type": "string",
      "description": "Context, initial observations, useful links."
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "statement", "test"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^h\\d+$"
          },
          "statement": {
            "type": "string",
            "description": "The hypothesis, stated in a testable way."
          },
          "test": {
            "type": "string",
            "description": "How to test it."
          },
          "result": {
            "type": ["string", "null"],
            "enum": ["confirmed", "refuted", "inconclusive", null]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Relative path to evidence in evidence/."
            }
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["order", "action"],
        "properties": {
          "order": {
            "type": "integer"
          },
          "action": {
            "type": "string",
            "description": "Action taken."
          },
          "result": {
            "type": ["string", "null"],
            "description": "Observed result."
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Relative paths to the associated evidence."
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Findings confirmed during the investigation."
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "type", "summary"],
        "properties": {
          "path": {
            "type": "string",
            "description": "Relative path (evidence/<file>) to the stored evidence."
          },
          "type": {
            "type": "string",
            "enum": ["log", "file", "note", "image", "link"]
          },
          "summary": {
            "type": "string",
            "description": "Summary of what this piece proves."
          }
        }
      }
    },
    "conclusion": {
      "type": ["string", "null"],
      "description": "Conclusion once the case is resolved."
    },
    "promotion": {
      "type": ["object", "null"],
      "required": ["target", "path", "date"],
      "properties": {
        "target": {
          "type": "string",
          "enum": ["fiche", "skill"]
        },
        "path": {
          "type": "string",
          "description": "Relative path of the promoted file in the KB."
        },
        "date": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Useful URLs or references."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
